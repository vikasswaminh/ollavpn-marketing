# Cloudflare Pages — _redirects for ollavpn.com
# https://developers.cloudflare.com/pages/configuration/redirects/
#
# Format: <source>  <destination>  <status>
# 301 = permanent, 302 = temporary, 200 = proxy (rewrite, no URL change).
# Patterns evaluated top-to-bottom; first match wins.
#
# Stage 1: no IA migrations from old paths require redirects. CF Pages
# already does clean-URL routing (/pqc → /pqc.html). This file mostly
# canonicalizes a few edge cases and reserves a clear place to add
# future redirects.

# ─── Canonical URL hygiene ────────────────────────────────
/index.html              /             301
/index                   /             301
/home                    /             301
/index.html?*            /:splat       301

# ─── Pricing removed 2026-08-24 (product is 100% free) ───
/pricing                 /free-vpn     301
/pricing.html            /free-vpn     301
/plus                    /free-vpn     301
/plus.html               /free-vpn     301

# Clean-URL canonicalization: extension-stripped is the sitemap
# canonical (see sitemap.xml). CF Pages auto-serves /pqc → /pqc.html,
# but external links to /pqc.html should resolve to /pqc to avoid
# duplicate-content signals to crawlers.
/pqc.html                /pqc          301
/killswitch.html         /killswitch   301
/in-tunnel-dns.html      /in-tunnel-dns  301
/peer-isolation.html     /peer-isolation 301

# ─── Tool / utility pages ─────────────────────────────────
# (none currently migrated)

# ─── Downloads handoff ────────────────────────────────────
# Direct downloads live on login.ollavpn.com/downloads/.
# The /dl/ landing page already links there; this redirect catches
# any external links that try /downloads/ on the marketing host.
/downloads/*             https://login.ollavpn.com/downloads/:splat  301

