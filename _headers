# Cloudflare Pages — headers for ollavpn.com
# https://developers.cloudflare.com/pages/configuration/headers/
#
# Two concerns:
#   1. Security headers on every response.
#   2. Cache rules per content type.
#
# Patterns are evaluated top-to-bottom; first match wins per header.
# /* is the catch-all and sets security baseline.

# ─── Security baseline (every response) ───────────────────
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-DNS-Prefetch-Control: on
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://login.ollavpn.com https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://login.ollavpn.com; object-src 'none'; upgrade-insecure-requests
  # 'unsafe-inline' for style-src is intentional: index.html contains an
  # inline <style> block and ~15 inline style="" attributes. Tightening
  # to a nonce-based CSP would require build-step injection; revisit
  # when the site moves off raw HTML.

# ─── Static assets: long cache, immutable-ish ─────────────
/*.css
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/*.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Self-hosted webfonts never change (versioned per filename).
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Images and icons.
/*.svg
  Cache-Control: public, max-age=2592000
/*.png
  Cache-Control: public, max-age=2592000
/*.jpg
  Cache-Control: public, max-age=2592000
/*.webp
  Cache-Control: public, max-age=2592000
/favicon.ico
  Cache-Control: public, max-age=2592000

# ─── SEO/AEO meta files: short cache so updates land fast ─
/sitemap.xml
  Cache-Control: public, max-age=3600
  Content-Type: application/xml; charset=utf-8
/robots.txt
  Cache-Control: public, max-age=3600
  Content-Type: text/plain; charset=utf-8
/llms.txt
  Cache-Control: public, max-age=3600
  Content-Type: text/plain; charset=utf-8
/llms-full.txt
  Cache-Control: public, max-age=3600
  Content-Type: text/plain; charset=utf-8
/ai.txt
  Cache-Control: public, max-age=3600
  Content-Type: text/plain; charset=utf-8
/humans.txt
  Cache-Control: public, max-age=3600
  Content-Type: text/plain; charset=utf-8
/.well-known/security.txt
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=utf-8
